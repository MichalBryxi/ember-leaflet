{
  "name": "ember-leaflet",
  "version": "5.1.3",
  "description": "Easy and declarative mapping for ember.",
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache\"",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"A v2 addon does not have tests, run tests in test-app\""
  },
  "homepage": "https://miguelcobain.github.io/ember-leaflet/",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "@embroider/addon-dev": "^7.1.3",
    "@eslint/js": "^9.23.0",
    "@ijlee2-frontend-configs/ember-template-lint": "^0.5.2",
    "@ijlee2-frontend-configs/eslint-config-ember": "^0.4.0",
    "@ijlee2-frontend-configs/prettier": "^0.2.3",
    "@ijlee2-frontend-configs/stylelint": "^0.2.3",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^2.4.0",
    "concurrently": "^9.1.2",
    "ember-template-lint": "^7.0.1",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "rollup": "^4.37.0",
    "rollup-plugin-copy": "^3.5.0",
    "stylelint": "^16.16.0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.9.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "broccoli-funnel": "^3.0.8",
    "broccoli-merge-trees": "^4.2.0",
    "decorator-transforms": "^2.3.0",
    "ember-composability-tools": "^1.2.0",
    "ember-in-element-polyfill": "^1.0.0",
    "ember-render-helpers": "^0.2.0",
    "fastboot-transform": "^0.1.3",
    "resolve": "^1.21.0"
  },
  "peerDependencies": {
    "ember-source": "^4.0.0 || ^5.0.0",
    "leaflet": ">=0.7"
  },
  "fastbootDependencies": [
    "crypto"
  ],
  "engines": {
    "node": "14.* || 16.* || >= 18"
  },
  "keywords": [
    "ember-addon",
    "leaflet",
    "ember",
    "ember-leaflet",
    "mapping",
    "maps"
  ],
  "repository": "https://github.com/miguelcobain/ember-leaflet",
  "license": "MIT",
  "author": "Miguel Andrade <jmandrade0@gmail.com>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "app-js": {},
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,scss,json,yaml,yml,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "blueprints",
    "dist"
  ]
}
