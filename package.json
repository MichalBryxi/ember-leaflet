{
  "name": "workspace-root",
  "version": "5.1.3",
  "private": true,
  "repository": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter ember-leaflet build",
    "lint": "pnpm --filter \"*\" lint",
    "lint:fix": "pnpm --filter \"*\" lint:fix",
    "prepare": "pnpm build",
    "start": "concurrently \"pnpm:start:*\" --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter ember-leaflet start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter \"*\" test"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  },
  "pnpm": {
    "overrides": {
     "@handlebars/parser": "2.1.0",
     "ember-fetch": "8.1.2"
    }
  }
}
