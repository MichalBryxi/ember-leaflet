{
  "name": "test-app",
  "version": "5.1.3",
  "description": "Easy and declarative mapping for ember.",
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache\"",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test",
    "test:ember-compatibility": "ember try:one"
  },
  "homepage": "https://miguelcobain.github.io/ember-leaflet/",
  "devDependencies": {
    "@babel/eslint-parser": "^7.21.3",
    "@babel/plugin-proposal-decorators": "^7.21.0",
    "@ember/optional-features": "^2.2.0",
    "@ember/string": "^3.0.1",
    "@ember/test-helpers": "^2.9.3",
    "@embroider/broccoli-side-watch": "^1.0.1",
    "@embroider/compat": "^3.4.4",
    "@embroider/core": "^3.4.4",
    "@embroider/test-setup": "^2.1.1",
    "@embroider/webpack": "^3.2.2",
    "@eslint/js": "^9.23.0",
    "@ijlee2-frontend-configs/ember-template-lint": "^0.5.2",
    "@ijlee2-frontend-configs/eslint-config-ember": "^0.4.0",
    "@ijlee2-frontend-configs/prettier": "^0.2.3",
    "@ijlee2-frontend-configs/stylelint": "^0.2.3",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.1.2",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "^6.2.0",
    "ember-cli-babel": "^7.26.11",
    "ember-cli-dependency-checker": "^3.3.1",
    "ember-cli-dependency-lint": "^2.0.1",
    "ember-cli-deploy": "^2.0.0",
    "ember-cli-deploy-build": "^2.0.0",
    "ember-cli-deploy-git": "^1.3.4",
    "ember-cli-favicon": "^3.0.0",
    "ember-cli-htmlbars": "^6.2.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-data": "~4.11.0",
    "ember-fetch": "^8.1.1",
    "ember-leaflet": "workspace:*",
    "ember-leaflet-marker-cluster": "^1.1.1",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^7.0.0",
    "ember-qunit": "^6.2.0",
    "ember-resolver": "^10.0.0",
    "ember-source": "^6.2.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.0.1",
    "ember-template-lint-plugin-prettier": "^4.1.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-ember": "^11.5.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-qunit": "^7.3.4",
    "leaflet": "^1.9.4",
    "loader.js": "^4.7.0",
    "prettier": "^3.5.3",
    "qunit": "^2.19.4",
    "qunit-dom": "^2.0.0",
    "sass": "^1.49.7",
    "stylelint": "^16.16.0",
    "stylelint-config-standard-scss": "^8.0.0",
    "stylelint-prettier": "^3.0.0",
    "webpack": "^5.90.2"
  },
  "peerDependencies": {
    "ember-source": "^4.0.0 || ^5.0.0",
    "leaflet": ">=0.7"
  },
  "fastbootDependencies": [
    "crypto"
  ],
  "engines": {
    "node": "14.* || 16.* || >= 18"
  },
  "keywords": [
    "leaflet",
    "ember",
    "ember-leaflet",
    "mapping",
    "maps"
  ],
  "repository": "https://github.com/miguelcobain/ember-leaflet",
  "license": "MIT",
  "author": "Miguel Andrade <jmandrade0@gmail.com>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "ember": {
    "edition": "octane"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,scss,json,yaml,yml,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "private": true
}
